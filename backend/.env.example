# —— REQUIRED ——————————————————————

# MongoDB connection string.
# Option A – Local MongoDB:  mongodb://127.0.0.1:27017/realtime-chat-app
# Option B – MongoDB Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/realtime-chat-app
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/realtime-chat-app?retryWrites=true&w=majority

# Any long random string – used to sign JWT tokens. Keep this secret!
# Generate one quickly: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_generated_secret_here

# —— OPTIONAL ——————————————————————

# Port the backend server listens on (default: 5000)
PORT=5000

# Frontend URL – used for CORS. Must match wherever you run the frontend.
CLIENT_URL=http://localhost:5173



